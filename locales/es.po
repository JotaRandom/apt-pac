msgstr "Se instalarán los siguientes paquetes NUEVOS:"

#: src/apt_pac/ui.py:534
msgid "The following extra packages will be installed:"
msgstr "Se instalarán los siguientes paquetes adicionales:"

#: src/apt_pac/ui.py:551
msgid "command"
msgstr "orden"

#: src/apt_pac/ui.py:555
msgid "apt-pac is a commandline package manager wrapper for pacman."
msgstr "apt-pac es un gestor de paquetes en línea de comandos sobre pacman."

#: src/apt_pac/ui.py:558
msgid "It provides an APT-like experience while ensuring system safety."
msgstr "Ofrece una experiencia similar a APT garantizando la seguridad del sistema."

#: src/apt_pac/ui.py:564
msgid "Command"
msgstr "Orden"

#: src/apt_pac/ui.py:568
msgid "update list of available packages (syncs -Sy and -Fy)"
msgstr "actualiza la lista de paquetes disponibles (sincroniza -Sy y -Fy)"

#: src/apt_pac/ui.py:569
msgid "upgrade the system by installing/upgrading packages"
msgstr "actualiza el sistema instalando o actualizando paquetes"

#: src/apt_pac/ui.py:570
msgid "same as upgrade"
msgstr "igual que upgrade"

#: src/apt_pac/ui.py:571
msgid "install packages (supports local .pkg.tar.zst files)"
msgstr "instala paquetes (admite archivos locales .pkg.tar.zst)"

#: src/apt_pac/ui.py:572
msgid "reinstall packages"
msgstr "reinstala paquetes"

#: src/apt_pac/ui.py:573
msgid "remove packages"
msgstr "elimina paquetes"

#: src/apt_pac/ui.py:574
msgid "remove packages and their configurations"
msgstr "elimina paquetes y su configuración"

#: src/apt_pac/ui.py:575
msgid "remove automatically all unused packages"
msgstr "elimina automáticamente los paquetes no utilizados"

#: src/apt_pac/ui.py:576
msgid "search in package descriptions (default: Official + AUR)"
msgstr "busca en descripciones de paquetes (por defecto: Oficial + AUR)"

#: src/apt_pac/ui.py:577
msgid "show package details"
msgstr "muestra información detallada del paquete"

#: src/apt_pac/ui.py:581
msgid ""
"list packages (--installed, --upgradable, --manual-installed, --all-"
"versions, --repo)"
msgstr ""
"lista paquetes (--installed, --upgradable, --manual-installed, --all-"
"versions, --repo)"

#: src/apt_pac/ui.py:584
msgid "show package dependencies (uses pactree if available)"
msgstr "muestra dependencias del paquete (usa pactree si está disponible)"

#: src/apt_pac/ui.py:585
msgid "show reverse dependencies"
msgstr "muestra dependencias inversas"

#: src/apt_pac/ui.py:586
msgid "show package install/removal scripts"
msgstr "muestra los scripts de instalación/eliminación del paquete"

#: src/apt_pac/ui.py:587
msgid "view package changelog"
msgstr "muestra el registro de cambios del paquete"

#: src/apt_pac/ui.py:588
msgid "show package version and candidate information"
msgstr "muestra la versión instalada y candidata del paquete"

#: src/apt_pac/ui.py:589
msgid "mark/unmark packages as auto/manual"
msgstr "marca o desmarca paquetes como automáticos/manuales"

#: src/apt_pac/ui.py:590
msgid "verify package database and system integrity"
msgstr "verifica la integridad del sistema y la base de datos"

#: src/apt_pac/ui.py:591
msgid "list all available package names"
msgstr "lista todos los nombres de paquetes disponibles"

#: src/apt_pac/ui.py:592
msgid "show package statistics"
msgstr "muestra estadísticas de paquetes"

#: src/apt_pac/ui.py:593
msgid "generate dependency graph in GraphViz format"
msgstr "genera el grafo de dependencias en formato GraphViz"

#: src/apt_pac/ui.py:594
msgid "show available versions of a package"
msgstr "muestra las versiones disponibles de un paquete"

#: src/apt_pac/ui.py:595
msgid "display pacman configuration"
msgstr "muestra la configuración de pacman"

#: src/apt_pac/ui.py:596
msgid "manage GPG keys for package verification"
msgstr "gestiona las claves GPG de verificación de paquetes"

#: src/apt_pac/ui.py:597
msgid "show how to add repositories"
msgstr "muestra cómo añadir repositorios"

#: src/apt_pac/ui.py:598
msgid "download packages without installing (pacman -Sw)"
msgstr "descarga paquetes sin instalarlos (pacman -Sw)"

#: src/apt_pac/ui.py:599
msgid "download package source (uses pkgctl)"
msgstr "descarga las fuentes del paquete (usa pkgctl)"

#: src/apt_pac/ui.py:600
msgid "show source package information"
msgstr "muestra información del paquete fuente"

#: src/apt_pac/ui.py:601
msgid "install build dependencies for a package"
msgstr "instala las dependencias de compilación de un paquete"

#: src/apt_pac/ui.py:602
msgid "edit the pacman.conf information file"
msgstr "edita el archivo de configuración pacman.conf"

#: src/apt_pac/ui.py:603
msgid "remove all cached package files (pacman -Scc)"
msgstr "borra todos los archivos de paquetes de la caché (pacman -Scc)"

#: src/apt_pac/ui.py:604
msgid "erase old downloaded archives (keeps last 3)"
msgstr "borra paquetes antiguos descargados (conserva los últimos 3)"

#: src/apt_pac/ui.py:605
msgid "search for packages containing a file"
msgstr "busca paquetes que contienen un fichero"

#: src/apt_pac/ui.py:606
msgid "read the latest Arch Linux news"
msgstr "lee las últimas noticias de Arch Linux"

#: src/apt_pac/ui.py:607
msgid "show package manual page"
msgstr "muestra la página de manual del paquete"

